# --- Groq (LLM generation) ---
GROQ_API_KEY=
# Any current Groq production model id. Swappable without code changes.
# openai/gpt-oss-20b is the cheapest/fastest current option - good default
# on a free/low-credit plan. Bump to openai/gpt-oss-120b for higher quality.
GROQ_MODEL=openai/gpt-oss-20b

# --- Voyage AI (embeddings) ---
VOYAGE_API_KEY=
# Any current Voyage embedding model id. Swappable without code changes.
# voyage-3.5-lite is the cheapest current general-purpose model.
VOYAGE_EMBEDDING_MODEL=voyage-3.5-lite

# --- ChromaDB ---
# Local server started via `npm run chroma:start` (no docker required).
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=book_documents

# --- Retrieval ---
RETRIEVAL_TOP_K=10
